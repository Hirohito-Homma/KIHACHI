{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kihachi.local/schema/song_spec-0.1.json",
  "title": "KIHACHI Music AI SongSpec v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "source_prompt",
    "seed",
    "song",
    "style",
    "groove",
    "arrangement",
    "harmony",
    "bass",
    "drums",
    "chords",
    "vocal"
  ],
  "properties": {
    "spec_version": { "const": "0.1" },
    "source_prompt": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "song": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "bpm", "key", "tonic", "tonic_pitch_class", "mode", "time_signature", "total_bars", "target_duration_sec"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "bpm": { "type": "number", "minimum": 30, "maximum": 300 },
        "key": { "type": "string" },
        "tonic": { "type": "string" },
        "tonic_pitch_class": { "type": "integer", "minimum": 0, "maximum": 11 },
        "mode": { "enum": ["major", "minor"] },
        "time_signature": { "const": "4/4" },
        "total_bars": { "type": "integer", "minimum": 1 },
        "target_duration_sec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genres", "darkness", "psychedelic"],
      "properties": {
        "genres": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "weight"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "weight": { "$ref": "#/$defs/unit" }
            }
          }
        },
        "darkness": { "$ref": "#/$defs/unit" },
        "psychedelic": { "$ref": "#/$defs/unit" }
      }
    },
    "groove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swing", "syncopation", "humanize"],
      "properties": {
        "swing": { "$ref": "#/$defs/unit" },
        "syncopation": { "$ref": "#/$defs/unit" },
        "humanize": { "$ref": "#/$defs/unit" }
      }
    },
    "arrangement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "start_bar", "length_bars", "energy", "minimal", "psychedelic"],
        "properties": {
          "name": { "type": "string" },
          "start_bar": { "type": "integer", "minimum": 0 },
          "length_bars": { "type": "integer", "minimum": 1 },
          "energy": { "$ref": "#/$defs/unit" },
          "minimal": { "type": "boolean" },
          "psychedelic": { "$ref": "#/$defs/unit" }
        }
      }
    },
    "harmony": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progression", "harmonic_rhythm_bars"],
      "properties": {
        "progression": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "harmonic_rhythm_bars": { "type": "integer", "minimum": 1 }
      }
    },
    "bass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "technique", "syncopation", "mutation", "octave_jump_probability", "ghost_note_probability"],
      "properties": {
        "role": { "type": "string" },
        "technique": { "type": "string" },
        "syncopation": { "$ref": "#/$defs/unit" },
        "mutation": { "$ref": "#/$defs/unit" },
        "octave_jump_probability": { "$ref": "#/$defs/unit" },
        "ghost_note_probability": { "$ref": "#/$defs/unit" }
      }
    },
    "drums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "kick_density", "hat_density", "dub_space"],
      "properties": {
        "pattern": { "type": "string" },
        "kick_density": { "$ref": "#/$defs/unit" },
        "hat_density": { "$ref": "#/$defs/unit" },
        "dub_space": { "$ref": "#/$defs/unit" }
      }
    },
    "chords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "articulation", "dub_delay"],
      "properties": {
        "instrument": { "type": "string" },
        "articulation": { "type": "string" },
        "dub_delay": { "$ref": "#/$defs/unit" }
      }
    },
    "vocal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "vocoder", "character"],
      "properties": {
        "enabled": { "type": "boolean" },
        "vocoder": { "type": "boolean" },
        "character": { "type": "string" }
      }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}

